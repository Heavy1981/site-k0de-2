# Chave da API da Anthropic (Claude)
# Obter em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Evolution API — URL base da sua instância
# Ex: https://sua-evolution-api.com  OU  http://localhost:8080
EVOLUTION_API_URL=https://sua-evolution-api.com

# Nome da instância criada no Evolution API
EVOLUTION_INSTANCE=kode

# API Key do Evolution API (definida no seu painel)
EVOLUTION_API_KEY=sua-api-key-aqui

# Porta do servidor webhook (padrão: 3001)
PORT=3001
