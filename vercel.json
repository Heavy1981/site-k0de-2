{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "privacidade.html", "use": "@vercel/static" },
    { "src": "blog/**/*.html", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
      },
      "continue": true
    },
    { "src": "/api/admin/auth",   "dest": "/api/admin/auth.js" },
    { "src": "/api/admin/verify", "dest": "/api/admin/verify.js" },
    { "src": "/api/admin/setup",  "dest": "/api/admin/setup.js" },
    { "src": "/api/blog/posts(.*)", "dest": "/api/blog/posts.js" },
    { "src": "/api/blog/upload",  "dest": "/api/blog/upload.js" },
    { "src": "/blog/post/(.*)",   "dest": "/blog/post.html" },
    { "src": "/blog/admin/dashboard", "dest": "/blog/admin/dashboard.html" },
    { "src": "/blog/admin/editor(.*)", "dest": "/blog/admin/editor.html" },
    { "src": "/blog/admin",       "dest": "/blog/admin/index.html" },
    { "src": "/blog",             "dest": "/blog/index.html" },
    { "src": "/privacidade",      "dest": "/privacidade.html" },
    { "src": "/(.*)",             "dest": "/index.html" }
  ]
}
